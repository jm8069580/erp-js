# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erp_js"

# JWT
JWT_SECRET="your-super-secret-key-change-in-production"
JWT_EXPIRATION="1h"

# App
PORT=3001
API_PREFIX="api/v1"
# Comma-separated list of allowed CORS origins (empty = allow all)
CORS_ORIGINS="http://localhost:5173"

# Session cookie (httpOnly)
COOKIE_SECURE=false
COOKIE_MAX_AGE_MS=3600000

# Notion (optional; the API returns 503 if not set)
NOTION_TOKEN=
NOTION_DOCS_PAGE_ID=3a5791edb25181748abff8b76d55a8d4

# FEL (Facturación Electrónica - PAC The Factory HKA)
# Integración opt-in: se activa poniendo FEL_ENABLED=true y las credenciales del PAC.
# Credenciales demo: FEL_USERNAME=qausertest FEL_PASSWORD=qausertest
FEL_ENABLED=false
FEL_BASE_URL="https://demointegracion.thefactoryhka.com.pa"
FEL_USERNAME=
FEL_PASSWORD=

# Datos fiscales del emisor usados por el seed (FelConfig id=1) cuando no hay
# configuración previa. Reemplazar con los datos reales de la empresa.
FEL_RAZON_SOCIAL="Mi Empresa S.A."
FEL_RUC="00000000-0-00000"
FEL_DV="00"
FEL_DIRECCION="Sin dirección configurada"
FEL_CODIGO_UBICACION="0-0-0"
FEL_PROVINCIA="PANAMA"
FEL_DISTRITO="PANAMA"
FEL_CORREGIMIENTO="SAN FELIPE"
FEL_SUCURSAL="0000"
FEL_PUNTO="001"
FEL_PAIS="PA"

# Seed admin
ADMIN_EMAIL="admin@erp.com"
ADMIN_PASSWORD="admin123"