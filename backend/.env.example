# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erp_js"

# JWT
JWT_SECRET="your-super-secret-key-change-in-production"
JWT_EXPIRATION="1h"

# App
PORT=3001
API_PREFIX="api/v1"
# Comma-separated list of allowed CORS origins (empty = allow all)
CORS_ORIGINS="http://localhost:5173"

# Session cookie (httpOnly)
COOKIE_SECURE=false
COOKIE_MAX_AGE_MS=3600000

# Notion (optional; the API returns 503 if not set)
NOTION_TOKEN=
NOTION_DOCS_PAGE_ID=3a5791edb25181748abff8b76d55a8d4

# Seed admin
ADMIN_EMAIL="admin@erp.com"
ADMIN_PASSWORD="admin123"